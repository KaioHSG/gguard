{
  "name": "gguard",
  "displayName": "GopherGuard",
  "description": "Syntax highlighting for GopherGuard .ggs scripts and .ggignore files",
  "version": "0.1.4",
  "publisher": "kaiohsg",
  "author": {
    "name": "Kaio HSG",
    "url": "https://github.com/KaioHSG"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KaioHSG/gguard.git",
    "directory": "editors/vscode"
  },
  "scripts": {
    "build": "npx --yes @vscode/vsce package --out gguard.vsix",
    "install-local": "code --install-extension gguard.vsix"
  },
  "contributes": {
    "languages": [
      {
        "id": "ggs",
        "aliases": [
          "GG Script",
          "ggs"
        ],
        "extensions": [
          ".ggs"
        ],
        "configuration": "./language-configuration-ggs.json",
        "icon": {
          "light": "./icons/shield.png",
          "dark": "./icons/shield.png"
        }
      },
      {
        "id": "ggignore",
        "aliases": [
          "GG Ignore",
          "ggignore"
        ],
        "filenames": [
          ".ggignore"
        ],
        "configuration": "./language-configuration-ggignore.json",
        "icon": {
          "light": "./icons/shield.png",
          "dark": "./icons/shield.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ggs",
        "scopeName": "source.ggs",
        "path": "./syntaxes/ggs.tmLanguage.json"
      },
      {
        "language": "ggignore",
        "scopeName": "source.ggignore",
        "path": "./syntaxes/ggignore.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ggs",
        "path": "./snippets/ggs.json"
      }
    ]
  }
}
