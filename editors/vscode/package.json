{
  "name": "gguard",
  "displayName": "GopherGuard",
  "description": "Syntax highlighting for GopherGuard .ggs scripts and .ggignore files",
  "version": "0.1.3",
  "publisher": "kaiohsg",
  "author": {
    "name": "Kaio HSG",
    "url": "https://github.com/KaioHSG"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KaioHSG/gguard.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "ggs",
        "aliases": [
          "GG Script",
          "ggs"
        ],
        "extensions": [
          ".ggs"
        ],
        "configuration": "./language-configuration-ggs.json"
      },
      {
        "id": "ggignore",
        "aliases": [
          "GG Ignore",
          "ggignore"
        ],
        "filenames": [
          ".ggignore"
        ],
        "configuration": "./language-configuration-ggignore.json"
      }
    ],
    "grammars": [
      {
        "language": "ggs",
        "scopeName": "source.ggs",
        "path": "./syntaxes/ggs.tmLanguage.json"
      },
      {
        "language": "ggignore",
        "scopeName": "source.ggignore",
        "path": "./syntaxes/ggignore.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ggs",
        "path": "./snippets/ggs.json"
      }
    ]
  }
}
